{
  "version": "2.0.0",
  "inputs": [
    {
      "id": "boardSelection",
      "description": "Target/board",
      "type": "pickString",
      "options": [
        "rp2040:pico - Raspberry Pi Pico",
        "rp2040:pico-rm2 - Raspberry Pi Pico with PIM730/RM2",
        "rp2040:picow - Raspberry Pi Pico W",
        "rp2040:rp2040-plus-4mb - Waveshare RP2040-Plus 4 MB",
        "rp2040:rp2040-zero - Waveshare RP2040-Zero compatible",
        "rp2350-arm:pico2 - Raspberry Pi Pico 2",
        "rp2350-arm:pico2w - Raspberry Pi Pico 2 W",
        "rp2350-riscv:pico2 - Raspberry Pi Pico 2",
        "stm32g474:nucleo-g474re - ST NUCLEO-G474RE"
      ],
      "default": "rp2350-arm:pico2w - Raspberry Pi Pico 2 W"
    }
  ],
  "tasks": [
    {
      "label": "Project: Build",
      "detail": "Ctrl+Shift+1 - configure CMake and compile firmware",
      "type": "shell",
      "command": "${config:jaszczurhal.vscodeEntry}",
      "args": [
        "build",
        "--project",
        "${workspaceFolder}"
      ],
      "group": {
        "kind": "build",
        "isDefault": true
      },
      "presentation": {
        "echo": true,
        "reveal": "always",
        "focus": false,
        "panel": "shared",
        "showReuseMessage": false,
        "clear": true
      },
      "problemMatcher": "$gcc"
    },
    {
      "label": "Project: Build (Debug)",
      "detail": "Compile with debug symbols (auto-run by F5/Run)",
      "type": "shell",
      "command": "${config:jaszczurhal.vscodeEntry}",
      "args": [
        "build-debug",
        "--project",
        "${workspaceFolder}"
      ],
      "group": "build",
      "presentation": {
        "echo": true,
        "reveal": "always",
        "focus": false,
        "panel": "shared",
        "showReuseMessage": false,
        "clear": true
      },
      "problemMatcher": "$gcc"
    },
    {
      "label": "Project: Upload",
      "detail": "Ctrl+Shift+2 - verified serial upload; falls back to UF2 when a BOOTSEL drive is visible",
      "type": "shell",
      "command": "${config:jaszczurhal.vscodeEntry}",
      "args": [
        "upload",
        "--project",
        "${workspaceFolder}"
      ],
      "presentation": {
        "echo": true,
        "reveal": "always",
        "focus": true,
        "panel": "shared",
        "showReuseMessage": false,
        "clear": true
      },
      "problemMatcher": []
    },
    {
      "label": "Project: Upload (UF2 / BOOTSEL)",
      "detail": "Ctrl+Shift+4 - build and copy firmware.uf2 to BOOTSEL storage",
      "type": "shell",
      "command": "${config:jaszczurhal.vscodeEntry}",
      "args": [
        "upload-uf2",
        "--project",
        "${workspaceFolder}"
      ],
      "presentation": {
        "echo": true,
        "reveal": "always",
        "focus": true,
        "panel": "shared",
        "showReuseMessage": false,
        "clear": true
      },
      "problemMatcher": []
    },
    {
      "label": "Project: Upload WHX Payload",
      "detail": "Upload doom1.whx through picotool; board must already be in BOOTSEL mode",
      "type": "shell",
      "command": "${workspaceFolder}/scripts/upload-whx-picotool.sh",
      "presentation": {
        "echo": true,
        "reveal": "always",
        "focus": true,
        "panel": "shared",
        "showReuseMessage": false,
        "clear": true
      },
      "problemMatcher": []
    },
    {
      "label": "Project: Serial Monitor",
      "detail": "Ctrl+Shift+3 - waits for Pico (VID:PID), connects, then reconnects after unplug",
      "type": "shell",
      "command": "${config:jaszczurhal.vscodeEntry}",
      "args": [
        "monitor",
        "--project",
        "${workspaceFolder}",
        "--lock-policy",
        "replace-own"
      ],
      "presentation": {
        "echo": true,
        "reveal": "always",
        "focus": true,
        "panel": "dedicated",
        "showReuseMessage": false
      },
      "isBackground": true,
      "problemMatcher": []
    },
    {
      "label": "Project: Debug Probe Monitor",
      "detail": "Ctrl+Shift+5 - monitor for Raspberry Pi Debug Probe / Picoprobe",
      "type": "shell",
      "command": "${config:jaszczurhal.vscodeEntry}",
      "args": [
        "monitor-probe",
        "--project",
        "${workspaceFolder}",
        "--lock-policy",
        "replace-own"
      ],
      "presentation": {
        "echo": true,
        "reveal": "always",
        "focus": true,
        "panel": "dedicated",
        "showReuseMessage": false
      },
      "isBackground": true,
      "problemMatcher": []
    },
    {
      "label": "Project: Serial Monitor (Any)",
      "detail": "Monitor any /dev/ttyACM* or /dev/ttyUSB* device",
      "type": "shell",
      "command": "${config:jaszczurhal.vscodeEntry}",
      "args": [
        "monitor-any",
        "--project",
        "${workspaceFolder}",
        "--lock-policy",
        "replace-own"
      ],
      "presentation": {
        "echo": true,
        "reveal": "always",
        "focus": true,
        "panel": "dedicated",
        "showReuseMessage": false
      },
      "isBackground": true,
      "problemMatcher": []
    },
    {
      "label": "Project: Refresh IntelliSense",
      "detail": "Ctrl+Shift+6 - compile project and generate c_cpp_properties.json",
      "type": "shell",
      "command": "${config:jaszczurhal.vscodeEntry}",
      "args": [
        "refresh-intellisense",
        "--project",
        "${workspaceFolder}"
      ],
      "presentation": {
        "echo": true,
        "reveal": "always",
        "focus": false,
        "panel": "shared",
        "showReuseMessage": false,
        "clear": true
      },
      "problemMatcher": []
    },
    {
      "label": "Project: Clean",
      "detail": "Ctrl+Shift+7 - remove .build directory",
      "type": "shell",
      "command": "${config:jaszczurhal.vscodeEntry}",
      "args": [
        "clean",
        "--project",
        "${workspaceFolder}"
      ],
      "presentation": {
        "echo": true,
        "reveal": "silent",
        "panel": "shared",
        "showReuseMessage": false
      },
      "problemMatcher": []
    },
    {
      "label": "Project: Clear USB Identity",
      "detail": "Build/upload neutral USB identity firmware to the selected verified port",
      "type": "shell",
      "command": "${config:jaszczurhal.vscodeEntry}",
      "args": [
        "clear-identity",
        "--project",
        "${workspaceFolder}"
      ],
      "presentation": {
        "echo": true,
        "reveal": "always",
        "focus": true,
        "panel": "shared",
        "showReuseMessage": false,
        "clear": true
      },
      "problemMatcher": []
    },
    {
      "label": "Project: Config Dump",
      "detail": "Print resolved JaszczurHAL VS Code project config",
      "type": "shell",
      "command": "${config:jaszczurhal.vscodeEntry}",
      "args": [
        "config-dump",
        "--project",
        "${workspaceFolder}"
      ],
      "presentation": {
        "echo": true,
        "reveal": "always",
        "focus": false,
        "panel": "shared",
        "showReuseMessage": false,
        "clear": true
      },
      "problemMatcher": []
    },
    {
      "label": "Project: List ports",
      "type": "shell",
      "command": "${config:jaszczurhal.vscodeEntry}",
      "args": [
        "list-ports",
        "--project",
        "${workspaceFolder}"
      ],
      "problemMatcher": []
    },
    {
      "label": "Project: Change port",
      "type": "shell",
      "command": "${config:jaszczurhal.vscodeEntry}",
      "args": [
        "change-port",
        "--project",
        "${workspaceFolder}"
      ],
      "problemMatcher": []
    },
    {
      "label": "Project: Select board",
      "type": "shell",
      "command": "${config:jaszczurhal.vscodeEntry}",
      "args": [
        "select-board",
        "--project",
        "${workspaceFolder}",
        "--interactive"
      ],
      "problemMatcher": []
    },
    {
      "label": "Project: Select board (GUI)",
      "type": "shell",
      "command": "${config:jaszczurhal.vscodeEntry}",
      "args": [
        "select-board",
        "--project",
        "${workspaceFolder}",
        "--selection",
        "${input:boardSelection}"
      ],
      "problemMatcher": []
    },
    {
      "label": "Project: Sync board picker",
      "detail": "Refresh target/board options from the JaszczurHAL registry",
      "type": "shell",
      "command": "${config:jaszczurhal.vscodeEntry}",
      "args": [
        "sync-board-picker",
        "--project",
        "${workspaceFolder}"
      ],
      "runOptions": {
        "runOn": "folderOpen",
        "instanceLimit": 1
      },
      "presentation": {
        "reveal": "never",
        "panel": "shared",
        "showReuseMessage": false
      },
      "problemMatcher": []
    }
  ]
}
