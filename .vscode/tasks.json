{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "Project: Build",
            "detail": "Ctrl+Shift+1 - configure CMake and compile firmware",
            "type": "shell",
            "command": "${config:jaszczurhal.vscodeEntry}",
            "args": [
                "build",
                "--project",
                "${workspaceFolder}"
            ],
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "presentation": {
                "echo": true,
                "reveal": "always",
                "focus": false,
                "panel": "shared",
                "showReuseMessage": false,
                "clear": true
            },
            "problemMatcher": {
                "owner": "arduino",
                "fileLocation": [
                    "autoDetect",
                    "${workspaceFolder}"
                ],
                "pattern": {
                    "regexp": "^(.+):(\\d+):(\\d+):\\s+(warning|error):\\s+(.+)$",
                    "file": 1,
                    "line": 2,
                    "column": 3,
                    "severity": 4,
                    "message": 5
                }
            }
        },
        {
            "label": "Project: Build (Debug)",
            "detail": "Compile with debug symbols (auto-run by F5/Run)",
            "type": "shell",
            "command": "${config:jaszczurhal.vscodeEntry}",
            "args": [
                "build-debug",
                "--project",
                "${workspaceFolder}"
            ],
            "group": "build",
            "presentation": {
                "echo": true,
                "reveal": "always",
                "focus": false,
                "panel": "shared",
                "showReuseMessage": false,
                "clear": true
            },
            "problemMatcher": {
                "owner": "arduino",
                "fileLocation": [
                    "autoDetect",
                    "${workspaceFolder}"
                ],
                "pattern": {
                    "regexp": "^(.+):(\\d+):(\\d+):\\s+(warning|error):\\s+(.+)$",
                    "file": 1,
                    "line": 2,
                    "column": 3,
                    "severity": 4,
                    "message": 5
                }
            }
        },
        {
            "label": "Project: Upload",
            "detail": "Ctrl+Shift+2 - verified serial upload; falls back to UF2 when a BOOTSEL drive is visible",
            "type": "shell",
            "command": "${config:jaszczurhal.vscodeEntry}",
            "args": [
                "upload",
                "--project",
                "${workspaceFolder}"
            ],
            "presentation": {
                "echo": true,
                "reveal": "always",
                "focus": true,
                "panel": "shared",
                "showReuseMessage": false,
                "clear": true
            },
            "problemMatcher": []
        },
        {
            "label": "Project: Upload (UF2 / BOOTSEL)",
            "detail": "Ctrl+Shift+4 - build and copy firmware.uf2 to BOOTSEL storage",
            "type": "shell",
            "command": "${config:jaszczurhal.vscodeEntry}",
            "args": [
                "upload-uf2",
                "--project",
                "${workspaceFolder}"
            ],
            "presentation": {
                "echo": true,
                "reveal": "always",
                "focus": true,
                "panel": "shared",
                "showReuseMessage": false,
                "clear": true
            },
            "problemMatcher": []
        },
        {
            "label": "Project: Upload WHX Payload",
            "detail": "Upload doom1.whx through picotool; board must already be in BOOTSEL mode",
            "type": "shell",
            "command": "${workspaceFolder}/scripts/upload-whx-picotool.sh",
            "presentation": {
                "echo": true,
                "reveal": "always",
                "focus": true,
                "panel": "shared",
                "showReuseMessage": false,
                "clear": true
            },
            "problemMatcher": []
        },
        {
            "label": "Project: Serial Monitor",
            "detail": "Ctrl+Shift+3 - waits for Pico (VID:PID), connects, then reconnects after unplug",
            "type": "shell",
            "command": "${config:jaszczurhal.vscodeEntry}",
            "args": [
                "monitor",
                "--project",
                "${workspaceFolder}",
                "--lock-policy",
                "replace-own"
            ],
            "presentation": {
                "echo": true,
                "reveal": "always",
                "focus": true,
                "panel": "dedicated",
                "showReuseMessage": false
            },
            "isBackground": true,
            "problemMatcher": []
        },
        {
            "label": "Project: Debug Probe Monitor",
            "detail": "Ctrl+Shift+5 - monitor for Raspberry Pi Debug Probe / Picoprobe",
            "type": "shell",
            "command": "${config:jaszczurhal.vscodeEntry}",
            "args": [
                "monitor-probe",
                "--project",
                "${workspaceFolder}",
                "--lock-policy",
                "replace-own"
            ],
            "presentation": {
                "echo": true,
                "reveal": "always",
                "focus": true,
                "panel": "dedicated",
                "showReuseMessage": false
            },
            "isBackground": true,
            "problemMatcher": []
        },
        {
            "label": "Project: Serial Monitor (Any)",
            "detail": "Monitor any /dev/ttyACM* or /dev/ttyUSB* device",
            "type": "shell",
            "command": "${config:jaszczurhal.vscodeEntry}",
            "args": [
                "monitor-any",
                "--project",
                "${workspaceFolder}",
                "--lock-policy",
                "replace-own"
            ],
            "presentation": {
                "echo": true,
                "reveal": "always",
                "focus": true,
                "panel": "dedicated",
                "showReuseMessage": false
            },
            "isBackground": true,
            "problemMatcher": []
        },
        {
            "label": "Project: Refresh IntelliSense",
            "detail": "Ctrl+Shift+6 - compile project and generate c_cpp_properties.json",
            "type": "shell",
            "command": "${config:jaszczurhal.vscodeEntry}",
            "args": [
                "refresh-intellisense",
                "--project",
                "${workspaceFolder}"
            ],
            "presentation": {
                "echo": true,
                "reveal": "always",
                "focus": false,
                "panel": "shared",
                "showReuseMessage": false,
                "clear": true
            },
            "problemMatcher": []
        },
        {
            "label": "Project: Clean",
            "detail": "Ctrl+Shift+7 - remove .build directory",
            "type": "shell",
            "command": "${config:jaszczurhal.vscodeEntry}",
            "args": [
                "clean",
                "--project",
                "${workspaceFolder}"
            ],
            "presentation": {
                "echo": true,
                "reveal": "silent",
                "panel": "shared",
                "showReuseMessage": false
            },
            "problemMatcher": []
        },
        {
            "label": "Project: Clear USB Identity",
            "detail": "Build/upload neutral USB identity firmware to the selected verified port",
            "type": "shell",
            "command": "${config:jaszczurhal.vscodeEntry}",
            "args": [
                "clear-identity",
                "--project",
                "${workspaceFolder}"
            ],
            "presentation": {
                "echo": true,
                "reveal": "always",
                "focus": true,
                "panel": "shared",
                "showReuseMessage": false,
                "clear": true
            },
            "problemMatcher": []
        },
        {
            "label": "Project: Config Dump",
            "detail": "Print resolved JaszczurHAL VS Code project config",
            "type": "shell",
            "command": "${config:jaszczurhal.vscodeEntry}",
            "args": [
                "config-dump",
                "--project",
                "${workspaceFolder}"
            ],
            "presentation": {
                "echo": true,
                "reveal": "always",
                "focus": false,
                "panel": "shared",
                "showReuseMessage": false,
                "clear": true
            },
            "problemMatcher": []
        }
    ]
}
