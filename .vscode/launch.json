{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Project: Debug pico2w (RP2350 ARM)",
            "type": "cortex-debug",
            "request": "launch",
            "cwd": "${workspaceFolder}",
            "executable": "${workspaceFolder}/.build/rp2350-arm/pico2w/firmware.elf",
            "servertype": "openocd",
            "device": "RP2350",
            "configFiles": [
                "interface/cmsis-dap.cfg",
                "target/rp2350.cfg"
            ],
            "runToEntryPoint": "main",
            "preLaunchTask": "Project: Build (Debug) pico2w",
            "openOCDLaunchCommands": [
                "adapter speed 2000"
            ]
        },
