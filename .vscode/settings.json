{
    "arduino.cliPath": "arduino-cli",
    "arduino.fqbn": "rp2040:rp2040:rpipico2w:flash=4194304_2097152,usbstack=tinyusb",
    "arduino.boardDescription": "Raspberry Pi Pico 2 W",
    "arduino.uploadPort": "/dev/ttyACM0",
    "arduino.sketchbookPath": "/home/jaszczurtd/development/projects_git",
    "arduino.buildDir": "${workspaceFolder}/.build/arduino",
    "arduino.verbose": false,
    "doom.bootProbeOnly": false,
    "doom.dualCoreColumns": false,
    "doom.asyncPlanes": false,
    "doom.videoSyncFlush": false,
    "doom.tftPanel": "ili9341",
    "doom.highresScene": true,
    "C_Cpp.default.configurationProvider": "ms-vscode.cpptools",
    "C_Cpp.errorSquiggles": "enabled",
    "cortex-debug.openocdPath": "${userHome}/.arduino15/packages/rp2040/tools/pqt-openocd/4.1.0-1aec55e/bin/openocd",
    "cortex-debug.openocdScriptsPath": "${userHome}/.arduino15/packages/rp2040/tools/pqt-openocd/4.1.0-1aec55e/share/openocd/scripts",
    "cortex-debug.gdbPath": "${userHome}/.arduino15/packages/rp2040/tools/pqt-gcc/4.1.0-1aec55e/bin/arm-none-eabi-gdb",
    "cortex-debug.svdFileRP2040": "${userHome}/.arduino15/packages/rp2040/hardware/rp2040/5.4.0/pico-sdk/src/rp2040/hardware_regs/RP2040.svd",
    "cortex-debug.svdFileRP2350": "${userHome}/.arduino15/packages/rp2040/hardware/rp2040/5.4.0/pico-sdk/src/rp2350/hardware_regs/RP2350.svd",
    "files.associations": {
        "*.ino": "cpp"
    },
    "files.exclude": {
        "**/.build": true
    },
    "search.exclude": {
        "**/.build": true
    }
}
